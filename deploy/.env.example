# ----- Required -----

# Cookie signing key. MUST be at least 32 bytes of random data. Generate:
#   openssl rand -base64 48
EMBER_SESSION_KEY=replace-me-with-32+-bytes-of-random-data-replace-me

# First-run admin credentials. Used only when the users table is empty.
# Password must be at least 8 characters or the app exits on startup.
EMBER_ADMIN_USER=admin
EMBER_ADMIN_PASSWORD=change-me-immediately

# ----- Caddy / TLS -----

# Hostname Caddy listens on.
#   - Real DNS name (e.g. ember.example.com) + CADDY_EMAIL + ports 80/443
#     publicly reachable → Caddy auto-fetches a Let's Encrypt cert.
#   - `localhost` or any unresolvable name → Caddy uses a local self-signed
#     cert (browsers will warn). For a homelab cert trusted by your own
#     machines, set `tls internal` in deploy/Caddyfile.
EMBER_HOSTNAME=localhost

# Email registered with Let's Encrypt for ACME notifications (expiry, etc.).
# Required only when actually getting LE certs (real hostname above).
CADDY_EMAIL=admin@example.com

# Host ports the Caddy container publishes to. Override when 80/443 are taken
# on the host (e.g. another reverse-proxy already runs there). Caddy still
# listens on 80/443 *inside* the container. Reach the site at the mapped
# host port — for HTTP_PORT=8080 / HTTPS_PORT=8443: https://localhost:8443.
# Letting Caddy issue Let's Encrypt certs requires public reachability on
# standard 80 (HTTP-01) or 443 (TLS-ALPN); for homelab/dev set `tls internal`
# in the Caddyfile and any ports are fine.
EMBER_HTTP_PORT=80
EMBER_HTTPS_PORT=443

# 80 → 443 redirect. Caddy redirects HTTP to HTTPS by default for every site
# with managed TLS. Set this to `1` (or any non-empty value) to disable the
# redirect — useful when Ember is fronted by another reverse proxy that
# already terminates TLS. Leave commented / empty to keep the redirect on.
# EMBER_DISABLE_HTTPS_REDIRECT=1

# ----- Optional knobs -----

EMBER_FRESH_WINDOW=6h
EMBER_POLL_CONCURRENCY=8
EMBER_POLL_TICK=60s
EMBER_LOG_LEVEL=info

# Everything below is commented out: the value shown is the default the app
# already uses, so uncommenting one only matters if you change it. The full
# reference is docs/configuration.md.

# Ollama model pulled at startup and summarized with. Used by both the ember
# service and the one-shot `ollama-pull` container, so they can't drift.
# `ember probe` recommends a size for this host.
# EMBER_OLLAMA_MODEL=qwen2.5:0.5b

# Minimum time between fetches of the same feed. Admin-settable at runtime in
# Settings → Feed check interval, which overrides this. Range 5m–24h.
# EMBER_POLL_MIN_INTERVAL=30m

# Lifetime of a session cookie. Settings → Sessions overrides it. Range 5m–90d.
# EMBER_SESSION_TTL=24h

# Drop article hero images at ingest.
# EMBER_DISABLE_IMAGES=0

# Turn off the daily "is there a newer Ember" check against the GitHub
# releases API. Sends nothing about your instance either way.
# EMBER_DISABLE_UPDATE_CHECK=0

# ----- Passkeys -----

# Canonical scheme://host your users reach Ember on. Required to enable
# passkey / WebAuthn sign-in — without it the WebAuthn RP ID can't be derived
# and the feature stays off. Must match the address in the browser bar,
# including a non-standard port.
# EMBER_PUBLIC_URL=https://ember.example.com

# Demand user verification (PIN / fingerprint / face) at sign-in rather than
# merely preferring it. Sets the boot-time default for the toggle in
# Settings → Passkeys. A security key with no PIN stops working once on.
# EMBER_PASSKEY_REQUIRE_UV=0

# ----- Summarization -----

# These seed boot-time defaults only. Settings → Language model changes them
# at runtime, and the stored value wins from then on.

# Turn AI summaries off entirely. Articles still surface, without a summary.
# EMBER_DISABLE_SUMMARIES=0

# Which backend generates summaries. Each one needs a different set of the
# vars below; a backend that is selected but missing one of its required vars
# does NOT fail at boot — summaries simply stay off (articles are stamped
# `disabled` and shown immediately) and the log says
# "backend selected but not usable yet".
#
#   ollama     (default) local inference, nothing leaves the host.
#              Needs: EMBER_OLLAMA_MODEL — the stack sets the endpoint itself.
#              EMBER_SUMMARY_MODEL / _BASE_URL are ignored.
#
#   openai     any endpoint speaking /v1/chat/completions — OpenAI, OpenRouter,
#              Groq, Mistral, Gemini's compatibility endpoint, vLLM,
#              llama.cpp's server, LiteLLM.
#              Needs: EMBER_SUMMARY_BASE_URL *and* EMBER_SUMMARY_MODEL.
#              EMBER_SUMMARY_API_KEY is required by hosted providers and
#              optional for a self-hosted server that wants no credential.
#
#   anthropic  Claude, via the Messages API.
#              Needs: EMBER_SUMMARY_API_KEY.
#              EMBER_SUMMARY_MODEL is optional (defaults to claude-opus-5),
#              EMBER_SUMMARY_BASE_URL is ignored.
#
# An unrecognized value here does fail at boot.
# The hosted backends send article title and text to that provider; the
# "nothing leaves the host" guarantee applies to ollama only.
# EMBER_SUMMARY_BACKEND=ollama

# Endpoint root for the openai backend. Must be http/https and include a host
# — a bad value fails at boot. "/v1" is appended when absent, so both
# https://api.openai.com and https://api.groq.com/openai/v1 are fine.
# EMBER_SUMMARY_BASE_URL=

# API key / bearer token for the openai and anthropic backends. Rotatable in
# Settings → Language model → Backend, where it's stored write-only and the
# stored value takes over from this one.
# EMBER_SUMMARY_API_KEY=

# Model id for the openai and anthropic backends, e.g. gpt-4o-mini or
# claude-opus-5. Required for openai. The ollama backend uses
# EMBER_OLLAMA_MODEL instead.
# EMBER_SUMMARY_MODEL=

# Worked examples — uncomment one block, and the EMBER_SUMMARY_BACKEND line
# above, to switch off local inference:
#
#   OpenAI:
#     EMBER_SUMMARY_BACKEND=openai
#     EMBER_SUMMARY_BASE_URL=https://api.openai.com
#     EMBER_SUMMARY_MODEL=gpt-4o-mini
#     EMBER_SUMMARY_API_KEY=sk-...
#
#   Claude:
#     EMBER_SUMMARY_BACKEND=anthropic
#     EMBER_SUMMARY_API_KEY=sk-ant-...
#     EMBER_SUMMARY_MODEL=claude-opus-5     # optional
#
#   Local vLLM / llama.cpp on the host (no key):
#     EMBER_SUMMARY_BACKEND=openai
#     EMBER_SUMMARY_BASE_URL=http://host.docker.internal:8000
#     EMBER_SUMMARY_MODEL=your-served-model-id
#
# On a hosted backend the `ollama` container still starts and still pulls its
# model (~400 MB of disk). Nothing calls it, so no model is ever loaded into
# memory — it just sits idle.

# How long a new article waits for its summary before being shown anyway
# (0–3600) and how long one summarization request may run before it's
# abandoned (10–900). Raise the timeout for CPU-only inference or a slow
# hosted model.
# EMBER_SUMMARY_GRACE_SECONDS=120
# EMBER_SUMMARY_TIMEOUT_SECONDS=90

# ----- Outbound email (daily digest) -----

# Settings → Email / SMTP sets the same values from the UI and takes
# precedence once saved. A host and a from-address are what enable the digest.
# EMBER_SMTP_HOST=smtp.example.com
# EMBER_SMTP_PORT=587
# EMBER_SMTP_USER=
# EMBER_SMTP_PASSWORD=
# EMBER_SMTP_FROM=ember@example.com

# STARTTLS on submission ports. When on, the server must offer it or the send
# fails — no silent plaintext downgrade. Set 0 only for a loopback relay;
# plain SMTP to a remote host is refused outright.
# EMBER_SMTP_STARTTLS=1

# ----- Inbound newsletter inbox -----

# Setting the domain gives every user an address (<handle>@<domain>) and
# starts Ember's inbound SMTP listener. It does NOT make mail reachable:
# this stack publishes no port for it, so you still need an MX record and
# something fronting port 25 → the listener. See docs/email-inbox.md.
# EMBER_EMAIL_DOMAIN=mail.example.com
# EMBER_EMAIL_LISTEN_ADDR=:2525
# EMBER_EMAIL_MAX_BYTES=26214400

# ----- Networking / security -----

# CIDRs whose X-Real-IP and X-Forwarded-Proto headers Ember trusts. The
# default covers the Docker bridge range Caddy sits on; change it only if
# your bridge subnet differs or another proxy fronts the stack. Empty =
# trust nobody, which mis-keys rate limiting when behind a proxy.
# EMBER_TRUSTED_PROXIES=172.16.0.0/12

# Secure flag on session + CSRF cookies. Caddy terminates TLS in front, so
# leave this on. Set 0 ONLY for a deliberate plain-HTTP deployment (e.g. over
# a VPN) — otherwise browsers drop the cookies and login silently fails.
# EMBER_SECURE_COOKIES=1

# Append "; preload" to Strict-Transport-Security. Only after the domain is
# (or will be) submitted to https://hstspreload.org — it's a long-term,
# browser-level commitment.
# EMBER_HSTS_PRELOAD=0

# Allow feeds on RFC1918 / loopback addresses by bypassing the SSRF block.
# Only with users you trust to add feeds.
# EMBER_ALLOW_PRIVATE_URLS=0

# ----- Build -----

# Version stamped into the binary (Settings → About, /metrics) when building
# locally. Released images get the git tag injected by the release workflow.
# EMBER_VERSION=dev
